# ExLA/XLA GPU Configuration
# Copy this to .env and adjust based on your CUDA version

# CRITICAL: Set based on your CUDA version (check with: nvcc --version)
# CUDA 12.1-12.x: Use cuda12
# CUDA 13.0+: Use cuda13
export XLA_TARGET=cuda12

# Optional: Cache directory for XLA builds/downloads
export XLA_CACHE_DIR=$HOME/.cache/xla

# Optional: CUDA paths (if not in default location)
export CUDA_PATH=/usr/local/cuda
export PATH=$CUDA_PATH/bin:$PATH
export LD_LIBRARY_PATH=$CUDA_PATH/lib64:$LD_LIBRARY_PATH

# Optional: Build from source (only if precompiled binary unavailable)
# export XLA_BUILD=true

# Loading this file:
# 1. Copy to .env: cp .env.example .env
# 2. Edit .env with your values
# 3. Load before mix: source .env
# 4. Verify: echo $XLA_TARGET (should show cuda12 or cuda13)
